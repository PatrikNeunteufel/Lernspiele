# Visual Studio: Arbeitsbereich-Zustand und Cache, nicht Teil des Projekts.
.vs/

# Fotos von Lernzielblättern bleiben lokal (können Handschrift von Kindern zeigen);
# ins Repo kommt nur die Abschrift in docs/lernziele/. Entscheid Patrik 2026-10-31.
material/
*.jpeg
*.jpg

# Gesicherte Spielerdaten aus der Statistik (Namen und Lernstand der Kinder) gehören nicht ins Repo.
lernspiele-*.json
# Ebenso die Sicherungen und Einladungen von Lernsteig und Gratwanderung (Vorname, Geburtsdatum, Lernstand; EP4).
lernsteig-*.json
gratwanderung-*.json

# Python-Zwischendateien der Werkzeuge
__pycache__/

# Entwickler-Schlüssel im Klartext (Entscheid E2 a): nur lokal; im Repo steht nur sein Hash
# (eulenpfad/spiele/gemeinsam/entwicklung.js). Neu erzeugen: python tools/entwickler_server.py --neuer-schluessel
entwickler.key

# secret keys
.secrets/